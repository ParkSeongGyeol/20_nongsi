APP_NAME=Nongsi AutoLog API
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///../data/nongsi.db
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_KEEPALIVE_SECONDS=60
MQTT_CLIENT_ID=nongsi-backend
MQTT_TOPIC=nongsi/devices/+/telemetry
DEVICE_CONFIG_PATH=./config/device_thresholds.json
DEVICE_ONLINE_TIMEOUT_SECONDS=10
STATE_STREAM_POLL_SECONDS=0.5
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SIMULATOR_DEVICE_ID=sprayer-001
SIMULATOR_INTERVAL_SECONDS=1.0
